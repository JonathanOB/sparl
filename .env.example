# Sparl web — environment matrix (Infra provisioning, D2 §16, D10 §18).
# Copy to `.env.local` and fill with STAGING/TEST credentials. Never commit real secrets.
# NEXT_PUBLIC_* are exposed to the browser — never put a secret there.

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Supabase (EU region, staging project) — §2.1 / §2.2 ─────────────────────
# New API key model: publishable + secret keys replace legacy anon + service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... — browser-safe, respects RLS (use with Clerk user token)
SUPABASE_SECRET_KEY=                    # sb_secret_... — SERVER-ONLY. Bypasses RLS. Never reaches a client.
SUPABASE_PROJECT_REF=                   # for the Supabase CLI / MCP
SUPABASE_DB_PASSWORD=                   # for migrations via CLI (staging)

# ── Clerk (auth; native Supabase Third-Party Auth) — §2.2 / §2.3 ────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
CLERK_WEBHOOK_SIGNING_SECRET=           # whsec_... from the Clerk webhook (see webhook.md)

# ── Stripe (TEST mode only during build) — §2.5 / Phase 10 ──────────────────
STRIPE_SECRET_KEY=                      # sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=     # pk_test_...
STRIPE_WEBHOOK_SECRET=                  # whsec_... (signature verification, §2.8)

# ── Anthropic (Claude — document extraction, assistant, recommendations) ─────
ANTHROPIC_API_KEY=
# Config-driven model tiers (§2.7 / D19 §7) — not hardcoded in source.
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_STRONG=claude-opus-4-8

# ── Redis (Upstash — cache / locks / rate-limit ONLY, not the job store §2.8) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Resend (transactional email) — Phase 9 ──────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Sentry (error monitoring: web/api/workers) ──────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
